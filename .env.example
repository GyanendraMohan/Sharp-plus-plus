# SHARP++ Environment Variables Configuration

# Path to Doppler Traces folder (contains raw stream files or windowed traces)
DOPPLER_TRACES_DIR=./doppler_traces

# Directory where trained models, logs, and evaluation metrics will be saved
OUTPUTS_DIR=./outputs

# Python path setting to ensure module imports resolve correctly
PYTHONPATH=.

# TensorFlow logging level (0 = all, 1 = filter INFO, 2 = filter INFO/WARN, 3 = filter ERROR)
TF_CPP_MIN_LOG_LEVEL=2

# GPU selection (set to device index like 0, or leave blank for CPU/MPS)
CUDA_VISIBLE_DEVICES=0
